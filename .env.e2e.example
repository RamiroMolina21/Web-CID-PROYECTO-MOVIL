# Copia este archivo a .env.e2e (ignorado por git) y rellena los valores de la BD de PRUEBAS.
# Nunca subas contraseñas reales al repositorio.

# API del backend (feature/jwt-auth). Se inyecta como VITE_API_URL al construir para E2E.
E2E_API_URL=http://localhost:5208/api
# Opcional: usar una web ya levantada en lugar de build + preview (4173)
# E2E_BASE_URL=http://localhost:5173

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_AUX_EMAIL=
E2E_AUX_PASSWORD=
E2E_DOCENTE_EMAIL=
E2E_DOCENTE_PASSWORD=
E2E_TUTOR_EMAIL=
E2E_TUTOR_PASSWORD=
# Rol sin acceso (debe recibir 403)
E2E_ESTUDIANTE_EMAIL=
E2E_ESTUDIANTE_PASSWORD=
